<?php
/**
 * Clears the mini-cart once the customer is back from Briqpay: the order was created
 * on the return, after the page's customer data was last read.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\View\Helper\SecureHtmlRenderer $secureRenderer
 */
$script = <<<'JS'
require(['Magento_Customer/js/customer-data'], function (customerData) {
    var attempts = 0;
    var intervalId = setInterval(function () {
        attempts++;
        try {
            if (typeof customerData.get('cart') !== 'undefined') {
                customerData.invalidate(['cart']);
                customerData.reload(['cart'], true);
                clearInterval(intervalId);
                return;
            }
        } catch (e) {
            // customer-data not ready yet; tried again below
        }
        if (attempts >= 10) {
            clearInterval(intervalId);
        }
    }, 300);
});
JS;
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', ['type' => 'text/javascript'], $script, false) ?>
