<?php /** @var \Briqpay\Payments\Block\Order\View\StrongAuthCustomData $block */ ?>
<?php /** @var \Magento\Framework\Escaper $escaper */ ?>
<?php if ($block->hasStrongAuthData()): ?>
    <div class="strong-auth-info-container">
        <span class="title">Strong Authentication Information</span>

        <?php if ($block->getStrongAuthProvider()): ?>
            <div>
                <strong>Provider:</strong> <?= $escaper->escapeHtml((string) $block->getStrongAuthProvider()) ?>
            </div>
        <?php endif; ?>

        <?php if ($block->getSignedAt()): ?>
            <div>
                <strong>Signed At:</strong> <?= $escaper->escapeHtml((string) $block->getSignedAt()) ?>
            </div>
        <?php endif; ?>

        <?php if ($block->getName()): ?>
            <div>
                <strong>Name:</strong> <?= $escaper->escapeHtml((string) $block->getName()) ?>
            </div>
        <?php endif; ?>

        <?php if ($block->getSurname()): ?>
            <div>
                <strong>Surname:</strong> <?= $escaper->escapeHtml((string) $block->getSurname()) ?>
            </div>
        <?php endif; ?>

        <?php if ($block->getGivenName()): ?>
            <div>
                <strong>Given Name:</strong> <?= $escaper->escapeHtml((string) $block->getGivenName()) ?>
            </div>
        <?php endif; ?>

        <?php if ($block->getDateOfBirth()): ?>
            <div>
                <strong>Date of Birth:</strong> <?= $escaper->escapeHtml((string) $block->getDateOfBirth()) ?>
            </div>
        <?php endif; ?>

        <div>
            <strong>Company Signatory:</strong> <?= $block->isCompanySignatory() ? 'Yes' : 'No' ?>
        </div>
    </div>
<?php endif; ?>
